{
  "name": "aurora-assistente",
  "version": "0.4.0",
  "private": true,
  "description": "Aurora — assistente virtual 3D para Windows com IA local gratuita",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/copy-voice-assets.cjs && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "node scripts/copy-voice-assets.cjs && node --check electron/main.cjs && node --check electron/preload.cjs && tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test electron/*.test.cjs scripts/*.test.cjs",
    "dist": "npm run build && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.171.0",
    "node-edge-tts": "^1.2.12",
    "@ricky0123/vad-web": "0.0.31",
    "onnxruntime-web": "1.22.0",
    "@pixiv/three-vrm": "^3.5.5",
    "sherpa-onnx-node": "^2.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.171.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^45.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.aurora.assistent",
    "productName": "Aurora",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Aurora-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "asarUnpack": [
      "node_modules/sherpa-onnx-node/**/*",
      "node_modules/sherpa-onnx-win-x64/**/*"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "esbuild": true
  },
  "optionalDependencies": {
    "sherpa-onnx-win-x64": "^2.0.1"
  }
}
